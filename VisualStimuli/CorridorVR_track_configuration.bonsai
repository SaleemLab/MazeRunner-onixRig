<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.0"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:gl="clr-namespace:Bonsai.Shaders;assembly=Bonsai.Shaders"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="GroupWorkflow">
        <Name>Track Textures</Name>
        <Workflow>
          <Nodes>
            <Expression xsi:type="Disable">
              <Builder xsi:type="GroupWorkflow">
                <Name>Archive</Name>
                <Workflow>
                  <Nodes>
                    <Expression xsi:type="Disable">
                      <Builder xsi:type="GroupWorkflow">
                        <Name>blocker</Name>
                        <Workflow>
                          <Nodes>
                            <Expression xsi:type="SubscribeSubject">
                              <Name>Draw3DStim</Name>
                            </Expression>
                            <Expression xsi:type="SubscribeSubject">
                              <Name>Blocker X</Name>
                            </Expression>
                            <Expression xsi:type="PropertyMapping">
                              <PropertyMappings>
                                <Property Name="TranslationX" />
                              </PropertyMappings>
                            </Expression>
                            <Expression xsi:type="SubscribeSubject">
                              <Name>Blocker Rotation X</Name>
                            </Expression>
                            <Expression xsi:type="PropertyMapping">
                              <PropertyMappings>
                                <Property Name="RotationX" />
                              </PropertyMappings>
                            </Expression>
                            <Expression xsi:type="SubscribeSubject">
                              <Name>Blocker Rotation Y</Name>
                            </Expression>
                            <Expression xsi:type="PropertyMapping">
                              <PropertyMappings>
                                <Property Name="RotationY" />
                              </PropertyMappings>
                            </Expression>
                            <Expression xsi:type="IncludeWorkflow" Path="BonVision:Primitives.DrawModel.bonsai">
                              <TranslationX>5</TranslationX>
                              <TranslationY>1</TranslationY>
                              <TranslationZ>-1</TranslationZ>
                              <ScaleX>10</ScaleX>
                              <ScaleY>10</ScaleY>
                              <ScaleZ>8</ScaleZ>
                              <MeshName>Plane</MeshName>
                              <Ambient>
                                <X>0.25</X>
                                <Y>0.25</Y>
                                <Z>0.25</Z>
                              </Ambient>
                              <Diffuse>
                                <X>0.3</X>
                                <Y>0.3</Y>
                                <Z>0.3</Z>
                              </Diffuse>
                              <Specular>
                                <X>0.3</X>
                                <Y>0.3</Y>
                                <Z>0.3</Z>
                              </Specular>
                              <SpecularExponent>1</SpecularExponent>
                              <RotationZ>0</RotationZ>
                              <RotationY>0</RotationY>
                              <RotationX>0</RotationX>
                            </Expression>
                            <Expression xsi:type="WorkflowOutput" />
                          </Nodes>
                          <Edges>
                            <Edge From="0" To="7" Label="Source1" />
                            <Edge From="1" To="2" Label="Source1" />
                            <Edge From="2" To="7" Label="Source2" />
                            <Edge From="3" To="4" Label="Source1" />
                            <Edge From="4" To="7" Label="Source3" />
                            <Edge From="5" To="6" Label="Source1" />
                            <Edge From="6" To="7" Label="Source4" />
                            <Edge From="7" To="8" Label="Source1" />
                          </Edges>
                        </Workflow>
                      </Builder>
                    </Expression>
                    <Expression xsi:type="Disable">
                      <Builder xsi:type="GroupWorkflow">
                        <Name>Track 1 Textures</Name>
                        <Workflow>
                          <Nodes>
                            <Expression xsi:type="GroupWorkflow">
                              <Name>Track 1 Main Room</Name>
                              <Workflow>
                                <Nodes>
                                  <Expression xsi:type="SubscribeSubject">
                                    <Name>MousePos</Name>
                                  </Expression>
                                  <Expression xsi:type="ExternalizedMapping">
                                    <Property Name="Expression" />
                                  </Expression>
                                  <Expression xsi:type="scr:ExpressionTransform">
                                    <scr:Expression>it+60</scr:Expression>
                                  </Expression>
                                  <Expression xsi:type="PropertyMapping">
                                    <PropertyMappings>
                                      <Property Name="TranslationZ" />
                                    </PropertyMappings>
                                  </Expression>
                                  <Expression xsi:type="GroupWorkflow">
                                    <Name>Ceil</Name>
                                    <Workflow>
                                      <Nodes>
                                        <Expression xsi:type="SubscribeSubject">
                                          <Name>Draw3DStim</Name>
                                        </Expression>
                                        <Expression xsi:type="ExternalizedMapping">
                                          <Property Name="TextureName" />
                                        </Expression>
                                        <Expression xsi:type="Combinator">
                                          <Combinator xsi:type="gl:BindTexture">
                                            <gl:TextureSlot>Texture0</gl:TextureSlot>
                                            <gl:ShaderName>TexturedModel</gl:ShaderName>
                                            <gl:TextureName>smoothed_fwn2</gl:TextureName>
                                            <gl:TextureTarget>Texture2D</gl:TextureTarget>
